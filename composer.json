{
    "name": "roundly-consulting/notifications-for-laravel",
    "description": "Typed notifications for Laravel: an in-app inbox with collapsing and contexts, per-user channel preferences, mandatory types, email de-dup, quiet hours, digests and date-relative reminders.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "notifications",
        "inbox",
        "notification-preferences",
        "digest",
        "reminders",
        "quiet-hours",
        "email",
        "escalation"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/notifications-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/notifications-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "roundly-consulting/crypto-for-laravel": "^2.0",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "roundly-consulting/options-for-laravel": "^2.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/contacts-for-laravel": "^2.0",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "suggest": {
        "roundly-consulting/contacts-for-laravel": "Route mail to the user's primary (or verified) email contact.",
        "roundly-consulting/teams-for-laravel": "Resolve recipients by team role or membership (docs recipe)."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Notifications\\": "src",
            "RoundlyConsulting\\Notifications\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Notifications\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Notifications\\NotificationsServiceProvider"
            ]
        },
        "pest": {
            "plugins": [
                "RoundlyConsulting\\Notifications\\Testing\\NotificationExpectations"
            ]
        }
    }
}
